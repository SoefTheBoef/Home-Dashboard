# Postgres connection string. Local dev: run `docker compose up -d`, then use the value below
# (matches docker-compose.yml). In production this is injected automatically by Render.
DATABASE_URL=postgres://dashboard:dashboard@localhost:5432/dashboard

# The two household accounts are created automatically on first boot from these values
# (no-op if any user already exists). Passwords are auto-generated in production — see render.yaml.
SEED_USER1_USERNAME=alice
SEED_USER1_PASSWORD=
SEED_USER1_DISPLAY_NAME=Alice
SEED_USER1_COLOR=#6366f1

SEED_USER2_USERNAME=bob
SEED_USER2_PASSWORD=
SEED_USER2_DISPLAY_NAME=Bob
SEED_USER2_COLOR=#ec4899

# Where uploaded photos are stored. In production this points at a Render Persistent Disk
# mount (see render.yaml); locally it defaults to a folder inside the project, so this can
# usually be left blank.
PHOTOS_DIR=

# Spotify integration — create an app at developer.spotify.com/dashboard,
# add SPOTIFY_REDIRECT_URI as a Redirect URI on that app (exact match required), then fill these in.
# Spotify requires a literal loopback IP (127.0.0.1), not "localhost", for local redirect URIs —
# access the app at that same address in your browser so cookies match during the OAuth flow.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:5173/spotify/callback
